<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<section class="section-sm max-w-4xl">
  <%- include('../partials/portal-nav', { backHref: '/admin', backLabel: 'Admin home' }) %>
  <p class="badge bg-secondary-100 text-secondary-800">Brand controls</p>
  <h1 class="mt-3 text-display-md">Site settings</h1>
  <p class="mt-2 text-primary-700">Manage identity, logo size, page colours and contact details. Changes apply across the public site after you save.</p>
  <% if (saved) { %><div class="mt-4 rounded-card border border-success-100 bg-success-50 px-4 py-3 text-success-700">Settings saved. Refresh the homepage to see colour and logo changes.</div><% } %>
  <form method="post" action="/admin/settings" class="mt-8 space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <section class="card">
      <h2 class="text-2xl">Brand identity</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <div><label class="label" for="site_name">Company name</label><input class="field" id="site_name" name="site_name" value="<%= settings.site_name || '' %>" /></div>
        <div><label class="label" for="site_tagline">Tagline</label><input class="field" id="site_tagline" name="site_tagline" value="<%= settings.site_tagline || '' %>" /></div>
        <div class="md:col-span-2">
          <label class="label" for="logo_url">Logo image URL</label>
          <input class="field" id="logo_url" name="logo_url" value="<%= settings.logo_url || '' %>" placeholder="/uploads/logo.png" />
          <p class="help"><a href="/admin/media" class="font-semibold underline">Upload a logo in Media</a>, then paste its URL here. Use a PNG or SVG with a transparent background for best results.</p>
        </div>
        <div>
          <label class="label" for="logo_mode">Header display</label>
          <select class="field" id="logo_mode" name="logo_mode">
            <option value="text" <%= (settings.logo_mode || 'text') === 'text' ? 'selected' : '' %>>Text title</option>
            <option value="logo" <%= settings.logo_mode === 'logo' ? 'selected' : '' %>>Logo only</option>
            <option value="both" <%= settings.logo_mode === 'both' ? 'selected' : '' %>>Logo and text</option>
          </select>
        </div>
        <div>
          <label class="label" for="logo_height">Logo height — desktop (px)</label>
          <input class="field" id="logo_height" name="logo_height" type="number" min="40" max="140" step="2" value="<%= settings.logo_height || '72' %>" />
          <p class="help">Try 80–110 if the logo is hard to read on desktop.</p>
        </div>
        <div>
          <label class="label" for="logo_max_width">Logo max width — desktop (px)</label>
          <input class="field" id="logo_max_width" name="logo_max_width" type="number" min="120" max="480" step="10" value="<%= settings.logo_max_width || '320' %>" />
        </div>
        <div>
          <label class="label" for="logo_height_mobile">Logo height — mobile (px)</label>
          <input class="field" id="logo_height_mobile" name="logo_height_mobile" type="number" min="28" max="80" step="2" value="<%= settings.logo_height_mobile || '40' %>" />
          <p class="help">Keeps the mobile header compact. Typical range 36–56.</p>
        </div>
        <div>
          <label class="label" for="logo_max_width_mobile">Logo max width — mobile (px)</label>
          <input class="field" id="logo_max_width_mobile" name="logo_max_width_mobile" type="number" min="80" max="280" step="10" value="<%= settings.logo_max_width_mobile || '168' %>" />
        </div>
      </div>
      <% if (settings.logo_url) { %>
        <div class="mt-6 rounded-2xl border border-primary-100 bg-primary-50/60 p-4">
          <p class="text-sm font-semibold text-primary-800">Logo preview</p>
          <div class="mt-3 flex flex-wrap items-end gap-6">
            <div>
              <p class="mb-2 text-xs font-medium text-primary-600">Desktop</p>
              <div class="inline-flex items-center rounded-xl bg-white px-4 py-3 shadow-soft">
                <img src="<%= settings.logo_url %>" alt="Desktop logo preview" style="height:<%= Math.min(140, Math.max(40, Number(settings.logo_height) || 72)) %>px;max-width:<%= Math.min(480, Math.max(120, Number(settings.logo_max_width) || 320)) %>px;width:auto;object-fit:contain" />
              </div>
            </div>
            <div>
              <p class="mb-2 text-xs font-medium text-primary-600">Mobile</p>
              <div class="inline-flex items-center rounded-xl bg-white px-4 py-3 shadow-soft">
                <img src="<%= settings.logo_url %>" alt="Mobile logo preview" style="height:<%= Math.min(80, Math.max(28, Number(settings.logo_height_mobile) || 40)) %>px;max-width:<%= Math.min(280, Math.max(80, Number(settings.logo_max_width_mobile) || 168)) %>px;width:auto;object-fit:contain" />
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </section>

    <section class="card">
      <h2 class="text-2xl">Colours &amp; backgrounds</h2>
      <p class="mt-2 text-sm text-primary-700">These drive buttons, headings, dark panels, accents and page background across the site.</p>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <div>
          <label class="label" for="primary_colour">Primary colour</label>
          <input class="field h-12" id="primary_colour" name="primary_colour" type="color" value="<%= settings.primary_colour || '#1a2b40' %>" />
          <p class="help">Header text, buttons, footer and dark sections.</p>
        </div>
        <div>
          <label class="label" for="secondary_colour">Accent colour</label>
          <input class="field h-12" id="secondary_colour" name="secondary_colour" type="color" value="<%= settings.secondary_colour || '#d1a24a' %>" />
          <p class="help">Gold highlights, badges and secondary buttons.</p>
        </div>
        <div>
          <label class="label" for="background_colour">Page background</label>
          <input class="field h-12" id="background_colour" name="background_colour" type="color" value="<%= settings.background_colour || '#fbf8f3' %>" />
        </div>
        <div>
          <label class="label" for="header_background">Header background</label>
          <input class="field h-12" id="header_background" name="header_background" type="color" value="<%= settings.header_background || settings.background_colour || '#fbf8f3' %>" />
        </div>
      </div>
    </section>

    <section class="card">
      <h2 class="text-2xl">Contact & social</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <div><label class="label" for="support_email">Public email</label><input class="field" id="support_email" name="support_email" type="email" value="<%= settings.support_email || '' %>" /></div>
        <div><label class="label" for="phone">Phone</label><input class="field" id="phone" name="phone" value="<%= settings.phone || '' %>" /></div>
        <div class="md:col-span-2"><label class="label" for="address">Business address</label><textarea class="field min-h-[80px]" id="address" name="address"><%= settings.address || '' %></textarea></div>
        <div><label class="label" for="instagram_url">Instagram URL</label><input class="field" id="instagram_url" name="instagram_url" value="<%= settings.instagram_url || '' %>" /></div>
        <div><label class="label" for="facebook_url">Facebook URL</label><input class="field" id="facebook_url" name="facebook_url" value="<%= settings.facebook_url || '' %>" /></div>
        <div><label class="label" for="tiktok_url">TikTok URL</label><input class="field" id="tiktok_url" name="tiktok_url" value="<%= settings.tiktok_url || '' %>" /></div>
      </div>
    </section>

    <section class="card">
      <h2 class="text-2xl">Footer & availability</h2>
      <div class="mt-5 space-y-4">
        <div><label class="label" for="footer_intro">Footer introduction</label><textarea class="field min-h-[90px]" id="footer_intro" name="footer_intro"><%= settings.footer_intro || '' %></textarea></div>
        <div class="grid gap-4 md:grid-cols-2">
          <div><label class="label" for="planner_enabled">Planner</label><select class="field" id="planner_enabled" name="planner_enabled"><option value="true" <%= settings.planner_enabled === 'true' ? 'selected' : '' %>>Enabled</option><option value="false" <%= settings.planner_enabled === 'false' ? 'selected' : '' %>>Disabled</option></select></div>
          <div><label class="label" for="maintenance_mode">Maintenance mode</label><select class="field" id="maintenance_mode" name="maintenance_mode"><option value="false" <%= settings.maintenance_mode !== 'true' ? 'selected' : '' %>>Off</option><option value="true" <%= settings.maintenance_mode === 'true' ? 'selected' : '' %>>On</option></select></div>
        </div>
      </div>
    </section>

    <button class="btn-primary" type="submit">Save site settings</button>
  </form>
</section>
<%- include('../partials/shell-end') %>
