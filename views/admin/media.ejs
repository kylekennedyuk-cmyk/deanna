<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<section class="section-sm">
  <div class="mb-8">
    <p class="badge bg-secondary-100 text-secondary-800">Visual assets</p>
    <h1 class="mt-3 text-display-md">Media library</h1>
    <p class="mt-2 text-primary-700">Upload images, organise them into folders and maintain useful alt text.</p>
  </div>

  <% if (saved) { %><div class="mb-5 rounded-card border border-success-100 bg-success-50 px-4 py-3 text-success-700">Media library updated.</div><% } %>
  <% if (error) { %><div class="mb-5 rounded-card border border-danger-100 bg-danger-50 px-4 py-3 text-danger-700" role="alert"><%= error %></div><% } %>

  <form method="post" action="/admin/media?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" class="card mb-8">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <h2 class="text-2xl">Upload an image</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <div class="md:col-span-2">
        <label class="label" for="image">Image file</label>
        <input class="field" id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" required />
        <p class="help">JPG, PNG, WebP, GIF or SVG up to 5MB.</p>
      </div>
      <div><label class="label" for="alt">Alt text</label><input class="field" id="alt" name="alt" placeholder="Describe what is visible" /></div>
      <div><label class="label" for="folder">Folder</label><input class="field" id="folder" name="folder" value="General" /></div>
      <div class="md:col-span-2"><label class="label" for="caption">Caption</label><input class="field" id="caption" name="caption" /></div>
    </div>
    <button class="btn-primary mt-5" type="submit">Upload image</button>
  </form>

  <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
    <% if (!media.length) { %>
      <div class="card sm:col-span-2 xl:col-span-3"><p class="text-primary-600">No images uploaded yet.</p></div>
    <% } %>
    <% media.forEach(function(item) { %>
      <article class="card overflow-hidden p-0">
        <img src="<%= item.url %>" alt="<%= item.alt || '' %>" class="aspect-[4/3] w-full bg-primary-50 object-cover" loading="lazy" />
        <form method="post" action="/admin/media/<%= item.id %>" class="space-y-3 p-5">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div><label class="label">Alt text</label><input class="field" name="alt" value="<%= item.alt || '' %>" /></div>
          <div><label class="label">Caption</label><input class="field" name="caption" value="<%= item.caption || '' %>" /></div>
          <div><label class="label">Folder</label><input class="field" name="folder" value="<%= item.folder || 'General' %>" /></div>
          <div class="rounded-xl bg-primary-50 px-3 py-2 text-xs text-primary-600 break-all"><%= item.url %></div>
          <div class="flex flex-wrap gap-2">
            <button class="btn-primary btn-sm" type="submit">Save details</button>
            <button class="btn-destructive btn-sm" type="submit" formaction="/admin/media/<%= item.id %>/delete" onclick="return confirm('Delete this image? Pages using it may show a broken image.')">Delete</button>
          </div>
        </form>
      </article>
    <% }) %>
  </div>
</section>
<%- include('../partials/shell-end') %>
