<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<section class="section-sm max-w-3xl">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="badge bg-white text-secondary-800 shadow-soft">Messages</p>
      <h1 class="mt-3 text-display-md">Plan #<%= plan.id %></h1>
    </div>
    <a href="/customer/plans/<%= plan.id %>" class="btn-ghost">Back to plan</a>
  </div>

  <div class="card space-y-4">
    <% if (!plan.messages.length) { %>
      <div class="rounded-2xl bg-blush/60 px-4 py-6 text-center">
        <p class="font-display text-2xl text-primary-950">Start the conversation</p>
        <p class="mt-2 text-primary-700">Ask about hotels, dates, or anything on your mind — Deanna will reply here.</p>
      </div>
    <% } %>
    <% plan.messages.forEach(function(msg) { %>
      <div class="rounded-2xl <%= msg.senderId === currentUser.id ? 'ml-4 bg-secondary-50 sm:ml-12' : 'mr-4 bg-primary-50 sm:mr-12' %> px-4 py-3">
        <div class="text-xs font-semibold uppercase tracking-wider text-primary-500"><%= msg.sender.name %> · <%= formatDateTime(msg.createdAt) %></div>
        <p class="mt-1 whitespace-pre-wrap text-primary-900"><%= msg.content %></p>
      </div>
    <% }) %>
  </div>

  <form method="post" action="/customer/plans/<%= plan.id %>/messages" class="card mt-4 space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="flex flex-wrap gap-2">
      <button type="button" class="chip" data-quick-reply="Could we look at alternative hotel options?" data-target="#message-content">Hotel options</button>
      <button type="button" class="chip" data-quick-reply="Are these dates still looking good for availability?" data-target="#message-content">Dates check</button>
      <button type="button" class="chip" data-quick-reply="Thank you — that all sounds lovely." data-target="#message-content">Thank you</button>
    </div>
    <div>
      <label class="label" for="message-content">Write a message</label>
      <textarea class="field min-h-[120px]" id="message-content" name="content" required placeholder="Ask a question or share a change…"></textarea>
    </div>
    <button class="btn-primary" type="submit">Send message</button>
  </form>
</section>
<%- include('../partials/shell-end') %>
