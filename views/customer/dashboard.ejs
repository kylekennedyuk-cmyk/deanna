<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<%
  const latest = plans[0] || null;
  let latestPrefs = {};
  try { latestPrefs = latest ? JSON.parse(latest.preferences || '{}') : {}; } catch (e) { latestPrefs = {}; }
%>
<section class="section-sm">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="badge bg-secondary-100 text-secondary-800">Your portal</p>
      <h1 class="mt-3 text-display-md sm:text-display-lg">Hello, <%= currentUser.name.split(' ')[0] %></h1>
      <p class="mt-2 text-lg text-primary-700">Your holiday plans, messages and latest updates with Deanna, all in one place.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/customer/profile" class="btn-ghost">Profile</a>
      <a href="/planner" class="btn-primary">Start a new plan</a>
    </div>
  </div>

  <% if (badgeCounts.messages > 0 || badgeCounts.plans > 0) { %>
  <div class="mb-8 flex flex-wrap gap-3">
    <% if (badgeCounts.plans > 0) { %>
      <a href="/customer" class="inline-flex items-center gap-2 rounded-full bg-secondary-100 px-4 py-2 text-sm font-semibold text-secondary-800">
        Proposals to review
        <%- include('../partials/count-badge', { count: badgeCounts.plans, label: badgeCounts.plans + ' proposals needing review' }) %>
      </a>
    <% } %>
    <% if (badgeCounts.messages > 0) { %>
      <span class="inline-flex items-center gap-2 rounded-full bg-primary-100 px-4 py-2 text-sm font-semibold text-primary-800">
        Unread messages
        <%- include('../partials/count-badge', { count: badgeCounts.messages, label: badgeCounts.messages + ' unread messages' }) %>
      </span>
    <% } %>
  </div>
  <% } %>

  <% if (latest) { %>
  <div class="mb-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <article class="card">
      <div class="flex items-start gap-3">
        <div class="icon-bubble">◎</div>
        <div>
          <p class="text-sm text-primary-500">Status</p>
          <div class="mt-2"><%- include('../partials/status-badge', { status: latest.status }) %></div>
        </div>
      </div>
    </article>
    <article class="card">
      <div class="flex items-start gap-3">
        <div class="icon-bubble">✦</div>
        <div>
          <p class="text-sm text-primary-500">Next action</p>
          <p class="mt-2 font-semibold text-primary-900"><%= nextAction(latest.status) %></p>
        </div>
      </div>
    </article>
    <article class="card">
      <div class="flex items-start gap-3">
        <div class="icon-bubble">◷</div>
        <div>
          <p class="text-sm text-primary-500">Trip dates</p>
          <p class="mt-2 font-semibold text-primary-900"><%= latest.travelDates %></p>
        </div>
      </div>
    </article>
    <article class="card">
      <div class="flex items-start gap-3">
        <div class="icon-bubble">£</div>
        <div>
          <p class="text-sm text-primary-500">Party · Budget</p>
          <p class="mt-2 font-semibold text-primary-900"><%= latest.partySize %> travellers · <%= formatMoney(latest.budget) %></p>
        </div>
      </div>
    </article>
  </div>
  <% } %>

  <div class="mb-4 flex items-center justify-between gap-3">
    <h2 class="text-display-sm">Your plans</h2>
  </div>

  <div class="grid gap-4">
    <% if (!plans.length) { %>
      <div class="card overflow-hidden p-0">
        <div class="grid md:grid-cols-[0.9fr_1.1fr]">
          <div class="min-h-[180px] bg-gradient-to-br from-primary-800 via-accent-400 to-secondary-400"></div>
          <div class="p-8">
            <h3 class="text-2xl">Your first adventure starts here</h3>
            <p class="mt-3 text-primary-700">Share a few preferences in the holiday planner and Deanna will begin shaping hotels, tickets, and pacing around your family.</p>
            <a href="/planner" class="btn-primary mt-6">Open the planner</a>
          </div>
        </div>
      </div>
    <% } %>

    <% plans.forEach(function(plan) { %>
      <%
        let prefs = {};
        try { prefs = JSON.parse(plan.preferences || '{}'); } catch (e) { prefs = {}; }
        const title = planTitle(plan, prefs);
      %>
      <article class="card-hover card-accent">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
          <div class="h-24 w-full shrink-0 overflow-hidden rounded-2xl bg-gradient-to-br from-primary-700 via-accent-500 to-secondary-400 sm:h-24 sm:w-32" aria-hidden="true"></div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="truncate text-2xl"><%= title %></h3>
              <%- include('../partials/status-badge', { status: plan.status }) %>
            </div>
            <p class="mt-2 text-sm text-primary-600"><%= plan.travelDates %> · party of <%= plan.partySize %> · updated <%= formatDateTime(plan.updatedAt) %></p>
            <p class="mt-1 text-sm text-primary-700"><%= nextAction(plan.status) %></p>
          </div>
          <div class="flex flex-wrap gap-2 sm:justify-end">
            <a href="/customer/plans/<%= plan.id %>" class="btn-primary btn-sm">
              View
              <% if (plan.status === 'sent') { %>
                <%- include('../partials/count-badge', { count: 1, label: 'Proposal needs review', compact: true }) %>
              <% } %>
            </a>
            <% const planUnread = (typeof unreadByPlan !== 'undefined' && unreadByPlan[plan.id]) ? unreadByPlan[plan.id] : 0; %>
            <a href="/customer/plans/<%= plan.id %>/messages" class="btn-secondary btn-sm">
              Message
              <%- include('../partials/count-badge', { count: planUnread, label: planUnread + ' unread messages', compact: true }) %>
            </a>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</section>
<%- include('../partials/shell-end') %>
