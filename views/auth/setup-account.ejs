<%- include('../partials/shell-start') %>
<section class="section max-w-xl">
  <p class="badge bg-secondary-100 text-secondary-800">Almost there</p>
  <h1 class="mt-3 text-display-md">Set up your account</h1>
  <p class="mt-3 text-primary-700">Your holiday plan is saved. Choose a password so you can come back to messages, documents and updates anytime.</p>

  <% if (!valid) { %>
    <div class="mt-8 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-800">
      This setup link is invalid or has expired. <a class="font-semibold underline" href="/forgot-password">Request a new password link</a> or <a class="font-semibold underline" href="/login">log in</a>.
    </div>
  <% } else { %>
    <% if (error) { %><div class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-800"><%= error %></div><% } %>

    <form method="post" action="/setup-account/<%= token %>" class="card mt-8 space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div>
        <label class="label" for="email">Email / username</label>
        <input class="field bg-primary-50" id="email" name="email" type="email" value="<%= email %>" readonly />
        <p class="help">Use this email address to log in.</p>
      </div>
      <div>
        <label class="label" for="password">Choose a password</label>
        <input class="field" id="password" name="password" type="password" minlength="8" required autocomplete="new-password" />
      </div>
      <div>
        <label class="label" for="passwordConfirm">Confirm password</label>
        <input class="field" id="passwordConfirm" name="passwordConfirm" type="password" minlength="8" required autocomplete="new-password" />
      </div>
      <button class="btn-primary w-full" type="submit">Save password &amp; open my plan</button>
    </form>
  <% } %>
</section>
<%- include('../partials/shell-end') %>
