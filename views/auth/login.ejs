<%- include('../partials/shell-start') %>
<section class="section max-w-md">
  <div class="card shadow-card">
    <p class="badge bg-secondary-50 text-secondary-800">Welcome back</p>
    <h1 class="mt-4 text-display-sm">Log in</h1>
    <p class="mt-2 text-primary-700">Access your planning portal with Deanna.</p>
    <% if (typeof planned !== 'undefined' && planned) { %>
      <div class="mt-4 rounded-2xl border border-secondary-200 bg-secondary-50 px-4 py-3 text-sm text-primary-800">Your plan is saved. Log in with your email to open it.</div>
    <% } %>
    <% if (typeof reset !== 'undefined' && reset) { %>
      <div class="mt-4 rounded-2xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Password updated. You can log in now.</div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mt-4 rounded-2xl border border-danger-100 bg-danger-50 px-4 py-3 text-sm text-danger-700" role="alert"><%= error %></div>
    <% } %>
    <form method="post" action="/login" class="mt-6 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div>
        <label class="label" for="username">Username or email</label>
        <input class="field" id="username" name="username" autocomplete="username" required />
      </div>
      <div>
        <div class="flex items-center justify-between gap-3">
          <label class="label" for="password">Password</label>
          <a href="/forgot-password" class="text-xs font-semibold text-secondary-700 hover:underline">Forgot password?</a>
        </div>
        <input class="field" id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <button class="btn-primary w-full" type="submit">Log in</button>
    </form>
    <p class="mt-6 text-sm text-primary-600">New here? <a class="font-semibold text-primary-900 underline" href="/register">Create an account</a></p>
  </div>
</section>
<%- include('../partials/shell-end') %>
