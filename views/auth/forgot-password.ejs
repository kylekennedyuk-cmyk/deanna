<%- include('../partials/shell-start') %>
<section class="section max-w-md">
  <div class="card shadow-card">
    <p class="badge bg-secondary-50 text-secondary-800">Portal access</p>
    <h1 class="mt-4 text-display-sm">Reset your password</h1>
    <p class="mt-2 text-primary-700">Enter the email used for your account. If it matches, we will send a secure reset link.</p>
    <% if (sent) { %>
      <div class="mt-5 rounded-card border border-success-100 bg-success-50 px-4 py-3 text-success-700">Check your inbox. If an account matches that email, a reset link is on its way.</div>
    <% } %>
    <% if (error) { %><div class="mt-5 rounded-card border border-danger-100 bg-danger-50 px-4 py-3 text-danger-700"><%= error %></div><% } %>
    <form method="post" action="/forgot-password" class="mt-6 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div><label class="label" for="email">Email address</label><input class="field" id="email" name="email" type="email" autocomplete="email" required /></div>
      <button class="btn-primary w-full" type="submit">Send reset link</button>
    </form>
    <a href="/login" class="btn-ghost mt-4 w-full">Back to login</a>
  </div>
</section>
<%- include('../partials/shell-end') %>
