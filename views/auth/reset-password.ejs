<%- include('../partials/shell-start') %>
<section class="section max-w-md">
  <div class="card shadow-card">
    <p class="badge bg-secondary-50 text-secondary-800">Portal access</p>
    <h1 class="mt-4 text-display-sm">Choose a new password</h1>
    <% if (!valid) { %>
      <div class="mt-5 rounded-card border border-danger-100 bg-danger-50 px-4 py-3 text-danger-700">This reset link is invalid or has expired.</div>
      <a href="/forgot-password" class="btn-primary mt-6 w-full">Request another link</a>
    <% } else { %>
      <p class="mt-2 text-primary-700">Use at least 10 characters and avoid a password you use elsewhere.</p>
      <% if (error) { %><div class="mt-5 rounded-card border border-danger-100 bg-danger-50 px-4 py-3 text-danger-700"><%= error %></div><% } %>
      <form method="post" action="/reset-password/<%= token %>" class="mt-6 space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div><label class="label" for="password">New password</label><input class="field" id="password" name="password" type="password" minlength="10" autocomplete="new-password" required /></div>
        <button class="btn-primary w-full" type="submit">Save new password</button>
      </form>
    <% } %>
  </div>
</section>
<%- include('../partials/shell-end') %>
