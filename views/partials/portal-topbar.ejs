<%
  const role = currentUser && currentUser.role;
  const portalHome = role === 'admin' ? '/admin' : '/agent';
  const portalLabel = role === 'admin' ? 'Admin' : 'Agent';
  const counts = typeof badgeCounts !== 'undefined' && badgeCounts ? badgeCounts : { total: 0 };
%>
<header class="portal-topbar">
  <div class="portal-topbar__start">
    <button
      type="button"
      class="portal-topbar__menu-btn"
      data-portal-sidebar-toggle
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="portal-sidebar"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
    <div class="portal-topbar__titles">
      <p class="portal-topbar__eyebrow"><%= portalLabel %> workspace</p>
      <p class="portal-topbar__user"><%= currentUser.name %></p>
    </div>
  </div>
  <div class="portal-topbar__actions">
    <a href="<%= portalHome %>" class="portal-topbar__chip">
      Dashboard
      <%- include('count-badge', { count: counts.total, label: counts.total + ' notifications', compact: true }) %>
    </a>
    <a href="/" class="portal-topbar__chip portal-topbar__chip--ghost hidden sm:inline-flex">Website</a>
    <form action="/logout" method="post" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn-logout btn-sm">Log out</button>
    </form>
  </div>
</header>
