<%
  const role = currentUser && currentUser.role;
  const portalHome = role === 'admin' ? '/admin' : (role === 'agent' ? '/agent' : '/customer');
  const portalLabel = role === 'admin' ? 'Admin dashboard' : (role === 'agent' ? 'Agent dashboard' : 'My dashboard');
  const counts = typeof badgeCounts !== 'undefined' && badgeCounts ? badgeCounts : { messages: 0, plans: 0, mailbox: 0, changeRequests: 0, total: 0 };
%>
<nav class="mb-6 flex flex-wrap items-center gap-2 border-b border-primary-100/80 pb-4" aria-label="Portal">
  <a href="<%= portalHome %>" class="btn-ghost btn-sm">
    ← <%= portalLabel %>
    <%- include('count-badge', { count: counts.total, label: counts.total + ' total notifications' }) %>
  </a>
  <% if (typeof backHref !== 'undefined' && backHref) { %>
    <a href="<%= backHref %>" class="btn-ghost btn-sm">← <%= typeof backLabel !== 'undefined' && backLabel ? backLabel : 'Back' %></a>
  <% } %>
  <% if (role === 'admin') { %>
    <a href="/admin/pages" class="btn-ghost btn-sm">Pages</a>
    <a href="/agent/site" class="btn-ghost btn-sm">Site content</a>
    <a href="/admin/users" class="btn-ghost btn-sm">Users</a>
    <a href="/admin/settings" class="btn-ghost btn-sm">Settings</a>
    <a href="/admin/notifications" class="btn-ghost btn-sm">Email</a>
    <a href="/admin/change-requests" class="btn-ghost btn-sm">
      Site changes
      <%- include('count-badge', { count: counts.changeRequests, label: counts.changeRequests + ' open site change requests' }) %>
    </a>
    <a href="/agent" class="btn-ghost btn-sm">Agent workspace</a>
    <a href="/agent/plans?filter=active" class="btn-ghost btn-sm">
      Plans
      <%- include('count-badge', { count: counts.plans, label: counts.plans + ' plans needing action' }) %>
    </a>
    <a href="/agent/inbox" class="btn-ghost btn-sm">
      Inbox
      <%- include('count-badge', { count: counts.messages, label: counts.messages + ' unread plan messages' }) %>
    </a>
    <a href="/agent/mailbox" class="btn-ghost btn-sm">
      Mailbox
      <%- include('count-badge', { count: counts.mailbox, label: counts.mailbox + ' unread emails' }) %>
    </a>
    <a href="/agent/password" class="btn-ghost btn-sm">Password</a>
  <% } else if (role === 'agent') { %>
    <a href="/agent/site" class="btn-ghost btn-sm">Edit site</a>
    <a href="/agent/plans?filter=active" class="btn-ghost btn-sm">
      Plans
      <%- include('count-badge', { count: counts.plans, label: counts.plans + ' plans needing action' }) %>
    </a>
    <a href="/agent/inbox" class="btn-ghost btn-sm">
      Inbox
      <%- include('count-badge', { count: counts.messages, label: counts.messages + ' unread plan messages' }) %>
    </a>
    <a href="/agent/mailbox" class="btn-ghost btn-sm">
      Mailbox
      <%- include('count-badge', { count: counts.mailbox, label: counts.mailbox + ' unread emails' }) %>
    </a>
    <a href="/agent/change-requests" class="btn-ghost btn-sm">Site changes</a>
    <a href="/agent/password" class="btn-ghost btn-sm">Password</a>
  <% } %>
  <a href="/" class="btn-ghost btn-sm ml-auto">View website</a>
</nav>
