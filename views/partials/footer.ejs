<footer class="mt-auto border-t border-primary-100 bg-primary-950 text-primary-100" style="background-color:var(--brand-primary,#0f1a28)">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-3 lg:px-8">
    <div>
      <% if (settings.logo_url && (settings.logo_mode === 'logo' || settings.logo_mode === 'both')) { %>
        <div class="mb-4 inline-flex rounded-2xl bg-white px-4 py-3 shadow-soft">
          <img src="<%= settings.logo_url %>" alt="<%= siteName %>" class="brand-logo-footer" loading="lazy" />
        </div>
      <% } %>
      <% if (!settings.logo_url || settings.logo_mode !== 'logo') { %><div class="font-display text-2xl text-white"><%= siteName %></div><% } %>
      <p class="mt-3 max-w-sm text-sm text-primary-200">
        <%= settings.footer_intro || 'Disneyland Paris specialist planning — practical advice, tailored itineraries and one place to manage your holiday.' %>
      </p>
      <% if (settings.instagram_url || settings.facebook_url || settings.tiktok_url) { %>
        <div class="mt-5 flex flex-wrap items-center gap-3 text-sm">
          <% if (settings.instagram_url) { %>
            <a href="<%= settings.instagram_url %>" rel="noopener noreferrer" target="_blank" class="social-icon-link social-icon-link-footer inline-flex items-center gap-2 rounded-full px-3 py-2 text-secondary-300 hover:text-white" aria-label="Follow on Instagram">
              <%- include('icon-instagram', { iconClass: 'h-5 w-5 shrink-0' }) %>
              <span>Follow on Instagram</span>
            </a>
          <% } %>
          <% if (settings.facebook_url) { %><a href="<%= settings.facebook_url %>" rel="noopener noreferrer" target="_blank" class="text-secondary-300 hover:text-white">Facebook</a><% } %>
          <% if (settings.tiktok_url) { %><a href="<%= settings.tiktok_url %>" rel="noopener noreferrer" target="_blank" class="text-secondary-300 hover:text-white">TikTok</a><% } %>
        </div>
      <% } %>
      <div class="mt-6" aria-label="Travel protection">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-secondary-300">Protected by</p>
        <div class="flex flex-wrap items-start gap-3">
          <div class="rounded-xl bg-white p-2 shadow-soft">
            <img src="/images/abta-protected.svg" alt="ABTA Protected" width="220" height="88" loading="lazy" style="display:block;width:132px;height:auto" />
            <% if (settings.abta_number) { %>
              <p class="mt-2 text-center text-xs font-semibold text-primary-800">Member <%= settings.abta_number %></p>
            <% } %>
          </div>
          <div class="rounded-xl bg-white p-2 shadow-soft">
            <img src="/images/atol-protected.svg" alt="ATOL Protected" width="220" height="88" loading="lazy" style="display:block;width:132px;height:auto" />
            <% if (settings.atol_number) { %>
              <p class="mt-2 text-center text-xs font-semibold text-primary-800">Licence <%= settings.atol_number %></p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <div>
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-secondary-300">Explore</h3>
      <ul class="space-y-2 text-sm">
        <% (navHeader || []).slice(0, 6).forEach(function(item) { %>
          <li><a class="hover:text-white" href="<%= item.href %>"><%= item.label %></a></li>
        <% }) %>
      </ul>
    </div>
    <div>
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-secondary-300">Useful</h3>
      <ul class="space-y-2 text-sm">
        <% (navFooter || []).forEach(function(item) { %>
          <li><a class="hover:text-white" href="<%= item.href %>"><%= item.label %></a></li>
        <% }) %>
        <li><a class="hover:text-white" href="/login">Customer login</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-4 text-xs text-primary-300">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-3 px-4 sm:px-6 lg:px-8" style="justify-content:space-between">
      <span>© <%= new Date().getFullYear() %> <%= siteName %>. All rights reserved.</span>
      <a
        href="https://prime.ax"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 hover:text-white"
        style="margin-left:auto"
      >
        <img
          src="https://prime.ax/wp-content/uploads/2026/01/cropped-logo_2026-1-32x32.png"
          alt="Prime.ax"
          width="16"
          height="16"
          loading="lazy"
          style="display:block;width:16px;height:16px"
        />
        <span>Built &amp; Managed by Prime.ax ltd</span>
      </a>
    </div>
  </div>
</footer>
