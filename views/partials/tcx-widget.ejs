<%
  const isPortal = typeof bodyClass !== 'undefined' && bodyClass && String(bodyClass).includes('portal-shell');
  const tcxCfg = typeof tcx !== 'undefined' && tcx ? tcx : { show: false };
  const showTcx = !isPortal && tcxCfg.show;
  const logoUrl = settings && settings.logo_url ? settings.logo_url : '';
  const siteLabel = typeof siteName !== 'undefined' && siteName ? siteName : 'Destinations With Deanna';
  const telHref = tcxCfg.callNumber
    ? ('tel:' + String(tcxCfg.callNumber).replace(/[^\d+]/g, ''))
    : '';
%>
<% if (showTcx) { %>
<div
  id="tcx-widget"
  class="tcx-widget"
  data-tcx-widget
  data-has-chat="<%= tcxCfg.hasChat ? 'true' : 'false' %>"
  data-phonesystem-url="<%= tcxCfg.phonesystemUrl || '' %>"
  data-party="<%= tcxCfg.party || '' %>"
>
  <button
    type="button"
    class="tcx-fab"
    data-tcx-toggle
    aria-expanded="false"
    aria-controls="tcx-panel"
    aria-label="Open chat and call options"
  >
    <% if (logoUrl) { %>
      <img class="tcx-fab-logo" src="<%= logoUrl %>" alt="" width="40" height="40" decoding="async" />
    <% } else { %>
      <svg class="tcx-fab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2zm2 4v2h12V8H6zm0 4v2h8v-2H6z"/>
      </svg>
    <% } %>
  </button>

  <div
    id="tcx-panel"
    class="tcx-panel"
    data-tcx-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="tcx-panel-title"
    hidden
  >
    <div class="tcx-panel-header">
      <% if (logoUrl) { %>
        <img class="tcx-panel-logo" src="<%= logoUrl %>" alt="<%= siteLabel %>" width="120" height="40" decoding="async" />
      <% } else { %>
        <p id="tcx-panel-title" class="tcx-panel-brand"><%= siteLabel %></p>
      <% } %>
      <button type="button" class="tcx-panel-close" data-tcx-close aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <% if (logoUrl) { %>
      <p id="tcx-panel-title" class="tcx-panel-greeting"><%= tcxCfg.greeting %></p>
    <% } else { %>
      <p class="tcx-panel-greeting"><%= tcxCfg.greeting %></p>
    <% } %>

    <div class="tcx-panel-actions">
      <% if (tcxCfg.hasChat) { %>
        <button type="button" class="tcx-action tcx-action-primary" data-tcx-live-chat>
          Live chat
        </button>
      <% } %>
      <% if (tcxCfg.talkUrl) { %>
        <a
          class="tcx-action <%= tcxCfg.hasChat ? 'tcx-action-secondary' : 'tcx-action-primary' %>"
          href="<%= tcxCfg.talkUrl %>"
          target="_blank"
          rel="noopener noreferrer"
          data-tcx-talk
        >Call in browser</a>
      <% } %>
      <% if (telHref) { %>
        <a
          class="tcx-action <%= (tcxCfg.hasChat || tcxCfg.talkUrl) ? 'tcx-action-secondary' : 'tcx-action-primary' %>"
          href="<%= telHref %>"
          data-tcx-tel
        >Call now<%= tcxCfg.callNumber ? ' · ' + tcxCfg.callNumber : '' %></a>
      <% } %>
    </div>
  </div>

  <% if (tcxCfg.hasChat) { %>
    <%# Hidden 3CX embed: default launcher is CSS/JS-hidden; Live chat clicks #wplc-chat-button in shadow DOM %>
    <div class="tcx-embed-host" data-tcx-embed aria-hidden="true">
      <%- tcxEmbedHtml %>
    </div>
    <script defer src="<%= tcxCfg.callusScriptUrl %>" id="tcx-callus-js" charset="utf-8"></script>
  <% } %>

  <%# Fallback slide-over if programmatic open of the hidden bubble fails %>
  <div class="tcx-fallback" data-tcx-fallback hidden>
    <div class="tcx-fallback-backdrop" data-tcx-fallback-close></div>
    <div class="tcx-fallback-sheet" role="dialog" aria-modal="true" aria-label="Live chat">
      <div class="tcx-fallback-toolbar">
        <p class="tcx-fallback-title">Live chat</p>
        <button type="button" class="tcx-panel-close" data-tcx-fallback-close aria-label="Close live chat">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <iframe
        class="tcx-fallback-frame"
        data-tcx-fallback-frame
        title="3CX live chat"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      <p class="tcx-fallback-hint">
        If chat does not load here,
        <a data-tcx-fallback-link href="#" target="_blank" rel="noopener noreferrer">open it in a new tab</a>.
      </p>
    </div>
  </div>
</div>
<script src="/js/tcx-widget.js" defer></script>
<% } %>
