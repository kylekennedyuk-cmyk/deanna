<dialog id="image-picker-modal" class="image-picker-modal" aria-labelledby="image-picker-modal-title">
  <div class="image-picker-modal-panel">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 id="image-picker-modal-title" class="text-2xl">Choose an image</h2>
        <p class="mt-1 text-sm text-primary-600">Upload a new file or pick one from the media library.</p>
      </div>
      <button type="button" class="btn-ghost btn-sm" data-image-modal-close aria-label="Close">Close</button>
    </div>

    <div class="mt-5 flex gap-2 border-b border-primary-100 pb-3">
      <button type="button" class="btn-secondary btn-sm image-picker-tab is-active" data-image-tab="upload">Upload</button>
      <button type="button" class="btn-ghost btn-sm image-picker-tab" data-image-tab="library">Choose from library</button>
    </div>

    <div class="mt-5" data-image-panel="upload">
      <label class="label" for="image-picker-file">Image file</label>
      <input
        class="field"
        id="image-picker-file"
        type="file"
        accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml"
      />
      <p class="help">JPG, PNG, WebP, GIF or SVG up to 5MB.</p>
      <label class="label mt-4" for="image-picker-alt">Alt text (optional)</label>
      <input class="field" id="image-picker-alt" type="text" placeholder="Describe what is visible" />
      <p class="mt-3 hidden text-sm text-danger-700" data-image-upload-error role="alert"></p>
      <button type="button" class="btn-primary mt-4" data-image-upload>Upload &amp; use</button>
    </div>

    <div class="mt-5 hidden" data-image-panel="library">
      <p class="mb-3 text-sm text-primary-600" data-image-library-status>Loading library…</p>
      <div class="image-picker-library" data-image-library></div>
    </div>
  </div>
</dialog>
