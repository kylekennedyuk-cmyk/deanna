<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %><%= siteName %></title>
  <% if (typeof seoDesc !== 'undefined' && seoDesc) { %>
  <meta name="description" content="<%= seoDesc %>" />
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body
  class="min-h-screen flex flex-col<%= typeof bodyClass !== 'undefined' && bodyClass ? ' ' + bodyClass : '' %>"
  style="--brand-primary:<%= settings.primary_colour || '#1a2b40' %>;--brand-secondary:<%= settings.secondary_colour || '#d1a24a' %>;--brand-bg:<%= settings.background_colour || '#fbf8f3' %>;--brand-header-bg:<%= settings.header_background || settings.background_colour || '#fbf8f3' %>;--logo-height:<%= Math.min(140, Math.max(40, Number(settings.logo_height) || 72)) %>px;--logo-max-width:<%= Math.min(480, Math.max(120, Number(settings.logo_max_width) || 320)) %>px"
>
<%- include('../partials/header') %>
<main class="flex-1">
