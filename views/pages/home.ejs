<%- include('../partials/shell-start', { bodyClass: 'public-home' }) %>
<%
  const pageSections = (typeof sections !== 'undefined' && sections && sections.length)
    ? sections
    : [];
%>

<% pageSections.forEach(function(section) { %>
  <% if (section.type === 'hero') { %>
<section class="home-hero relative isolate overflow-hidden bg-primary-950 text-white" data-home-hero>
  <div class="absolute inset-0">
    <img
      src="<%= section.image || '' %>"
      alt="<%= section.imageAlt || 'Disneyland Paris' %>"
      class="h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary-950/75 via-primary-950/45 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary-950/90 via-transparent to-transparent"></div>
  </div>

  <div class="home-hero-content relative mx-auto flex w-full max-w-6xl items-center px-4 sm:px-6 lg:px-8">
    <div class="hero-copy-panel w-full max-w-2xl animate-fadeUp rounded-[2rem] border border-white/20 p-8 shadow-lift sm:p-11">
      <% if (section.eyebrow) { %>
        <p class="badge bg-secondary-400/20 text-secondary-200 ring-1 ring-secondary-300/30"><%= section.eyebrow %></p>
      <% } %>
      <h1 class="mt-6 text-balance text-white">
        <%= section.headline || section.heading || '' %>
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-primary-100 sm:text-xl">
        <%= section.subheadline || section.text || '' %>
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <% if (section.primaryHref || (section.primaryCta && section.primaryCta.href)) { %>
          <a href="<%= section.primaryHref || section.primaryCta.href %>" class="btn bg-secondary-400 text-primary-950 shadow-gold hover:-translate-y-0.5 hover:bg-secondary-300">
            <%= section.primaryLabel || (section.primaryCta && section.primaryCta.label) || 'Start planning' %>
          </a>
        <% } %>
        <% if (section.secondaryHref || (section.secondaryCta && section.secondaryCta.href)) { %>
          <a href="<%= section.secondaryHref || section.secondaryCta.href %>" class="btn border border-white/40 bg-white/10 text-white hover:bg-white/20">
            <%= section.secondaryLabel || (section.secondaryCta && section.secondaryCta.label) || 'Learn more' %>
          </a>
        <% } %>
      </div>
      <% if (section.points && section.points.length) { %>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-primary-100">
          <% section.points.forEach(function(point) { %>
            <li class="flex items-center gap-2"><span class="text-secondary-300">✦</span> <%= point %></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
</section>

  <% } else if (section.type === 'why') { %>
<section class="section">
  <div class="mb-12 max-w-2xl">
    <% if (section.eyebrow) { %><p class="badge bg-secondary-50 text-secondary-800"><%= section.eyebrow %></p><% } %>
    <h2 class="mt-4"><%= section.title || section.heading %></h2>
    <% if (section.text) { %><p class="mt-4 text-lg text-primary-700"><%= section.text %></p><% } %>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    <% (section.items || []).forEach(function(item) { %>
      <article class="card-hover card-accent">
        <div class="icon-bubble mb-5">✦</div>
        <h3 class="text-2xl"><%= item.title %></h3>
        <p class="mt-3 leading-relaxed text-primary-700"><%= item.text %></p>
      </article>
    <% }) %>
  </div>
</section>

  <% } else if (section.type === 'process') { %>
<section class="bg-blush/70">
  <div class="section">
    <div class="mb-12 max-w-2xl">
      <% if (section.eyebrow) { %><p class="badge bg-white/80 text-primary-800"><%= section.eyebrow %></p><% } %>
      <h2 class="mt-4"><%= section.title || section.heading %></h2>
      <% if (section.text) { %><p class="mt-4 text-lg text-primary-700"><%= section.text %></p><% } %>
    </div>
    <ol class="grid gap-6 md:grid-cols-3">
      <% (section.steps || section.items || []).forEach(function(step, i) { %>
        <li class="card-hover">
          <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-full bg-primary-900 font-display text-xl text-white"><%= i + 1 %></div>
          <h3 class="text-2xl"><%= step.title %></h3>
          <p class="mt-3 text-primary-700"><%= step.text %></p>
        </li>
      <% }) %>
    </ol>
    <% if (section.primaryHref) { %>
      <div class="mt-12">
        <a href="<%= section.primaryHref %>" class="btn-primary"><%= section.primaryLabel || 'Begin your plan' %></a>
      </div>
    <% } %>
  </div>
</section>

  <% } else if (section.type === 'featureCards') { %>
<section class="section">
  <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-2xl">
      <% if (section.eyebrow) { %><p class="badge bg-secondary-50 text-secondary-800"><%= section.eyebrow %></p><% } %>
      <h2 class="mt-4"><%= section.heading %></h2>
      <% if (section.text) { %><p class="mt-4 text-lg text-primary-700"><%= section.text %></p><% } %>
    </div>
    <% if (section.primaryHref) { %>
      <a href="<%= section.primaryHref %>" class="btn-secondary"><%= section.primaryLabel || 'Learn more' %></a>
    <% } %>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    <% (section.cards || []).forEach(function(item) { %>
      <article class="card-hover card-accent overflow-hidden p-0">
        <% if (item.image) { %>
          <div class="relative aspect-[4/3] overflow-hidden">
            <img src="<%= item.image %>" alt="<%= item.title || '' %>" class="h-full w-full object-cover transition duration-500 hover:scale-105" loading="lazy" />
          </div>
        <% } %>
        <div class="p-6">
          <h3 class="text-2xl"><%= item.title %></h3>
          <p class="mt-3 text-primary-700"><%= item.text %></p>
          <% if (item.href) { %><a href="<%= item.href %>" class="mt-4 inline-block text-sm font-semibold text-secondary-700 hover:underline"><%= item.label || 'Read more' %> →</a><% } %>
        </div>
      </article>
    <% }) %>
  </div>
</section>

  <% } else if (section.type === 'split') { %>
<section class="section">
  <div class="grid items-center gap-10 lg:grid-cols-2">
    <div>
      <% if (section.eyebrow) { %><p class="badge bg-secondary-50 text-secondary-800"><%= section.eyebrow %></p><% } %>
      <h2 class="mt-4"><%= section.heading %></h2>
      <% if (section.text) { %><p class="mt-4 text-lg text-primary-700"><%= section.text %></p><% } %>
      <div class="mt-8 flex flex-wrap gap-3">
        <% if (section.primaryHref) { %><a href="<%= section.primaryHref %>" class="btn-secondary"><%= section.primaryLabel || 'Learn more' %></a><% } %>
        <% if (section.secondaryHref) { %><a href="<%= section.secondaryHref %>" class="btn-ghost"><%= section.secondaryLabel || 'More' %></a><% } %>
      </div>
    </div>
    <div class="card overflow-hidden p-0">
      <% if (section.image) { %>
        <img src="<%= section.image %>" alt="<%= section.imageAlt || '' %>" class="aspect-[16/11] w-full object-cover" loading="lazy" />
      <% } %>
      <% if (section.panelTitle || section.panelText) { %>
        <div class="p-6">
          <% if (section.panelTitle) { %><h3 class="text-2xl"><%= section.panelTitle %></h3><% } %>
          <% if (section.panelText) { %><p class="mt-2 text-primary-700"><%= section.panelText %></p><% } %>
        </div>
      <% } %>
    </div>
  </div>
</section>

  <% } else if (section.type === 'highlights') { %>
<section class="bg-primary-950 text-white">
  <div class="section">
    <div class="mb-12 max-w-2xl">
      <% if (section.eyebrow) { %><p class="badge bg-secondary-400/20 text-secondary-200"><%= section.eyebrow %></p><% } %>
      <h2 class="mt-4 text-white"><%= section.heading %></h2>
      <% if (section.text) { %><p class="mt-4 text-lg text-primary-100"><%= section.text %></p><% } %>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      <% (section.cards || []).forEach(function(item) { %>
        <article class="group overflow-hidden rounded-card border border-white/10 bg-white/5">
          <% if (item.image) { %>
            <div class="aspect-[4/3] overflow-hidden">
              <img src="<%= item.image %>" alt="<%= item.title || '' %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
            </div>
          <% } %>
          <div class="p-5">
            <h3 class="text-xl text-white"><%= item.title %></h3>
            <p class="mt-2 text-sm text-primary-100"><%= item.text %></p>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

  <% } else if (section.type === 'testimonials') { %>
<section class="section">
  <div class="mb-12 max-w-2xl">
    <% if (section.eyebrow) { %><p class="badge bg-secondary-50 text-secondary-800"><%= section.eyebrow %></p><% } %>
    <h2 class="mt-4"><%= section.heading %></h2>
    <% if (section.text) { %><p class="mt-4 text-lg text-primary-700"><%= section.text %></p><% } %>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    <% (section.items || section.cards || []).forEach(function(item) { %>
      <figure class="card-hover card-accent flex h-full flex-col">
        <div class="text-2xl text-secondary-500" aria-hidden="true">★★★★★</div>
        <blockquote class="mt-4 flex-1 text-lg leading-relaxed text-primary-800"><%= item.text || item.quote %></blockquote>
        <figcaption class="mt-5 border-t border-primary-100 pt-4 text-sm">
          <span class="font-semibold text-primary-950"><%= item.title || item.name %></span>
          <% if (item.label || item.meta) { %><span class="block text-primary-500"><%= item.label || item.meta %></span><% } %>
        </figcaption>
      </figure>
    <% }) %>
  </div>
</section>

  <% } else if (section.type === 'cta') { %>
<section class="section pt-0 text-center">
  <div class="mx-auto max-w-2xl rounded-[2rem] border border-secondary-200/70 bg-gradient-to-br from-white via-secondary-50/40 to-blush px-8 py-14 shadow-soft">
    <h2><%= section.heading %></h2>
    <% if (section.text) { %><p class="mx-auto mt-4 max-w-xl text-lg text-primary-700"><%= section.text %></p><% } %>
    <% if (section.primaryHref) { %>
      <a href="<%= section.primaryHref %>" class="btn-primary mt-8"><%= section.primaryLabel || 'Start planning' %></a>
    <% } %>
  </div>
</section>
  <% } %>
<% }) %>

<%- include('../partials/shell-end') %>
