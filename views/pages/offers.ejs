<%- include('../partials/shell-start') %>
<section class="relative overflow-hidden bg-primary-950 text-white">
  <img src="https://images.unsplash.com/photo-1742079741493-fd9845d816f9?auto=format&fit=crop&w=1600&q=85" alt="Sleeping Beauty Castle at Disneyland Paris" class="absolute inset-0 h-full w-full object-cover opacity-30" />
  <div class="absolute inset-0 bg-gradient-to-r from-primary-950 via-primary-950/90 to-primary-950/40"></div>
  <div class="section relative">
    <p class="badge bg-secondary-400/20 text-secondary-200">Offers & packages</p>
    <h1 class="mt-5 max-w-3xl text-white">Disneyland Paris value that fits your dates</h1>
    <p class="mt-5 max-w-2xl text-lg text-primary-100">Deanna checks hotel type, ticket length, room occupancy and the full package — not only the headline price — before recommending an offer.</p>
    <a href="/planner" class="btn mt-8 bg-secondary-400 text-primary-950 hover:bg-secondary-300">Check my dates</a>
  </div>
</section>

<section class="section">
  <div class="mb-10">
    <h2>Current featured offers</h2>
    <p class="mt-3 max-w-2xl text-primary-700">Availability and terms can change. Ask Deanna to confirm the live package for your party.</p>
  </div>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <% if (!deals.length) { %>
      <div class="card md:col-span-2">
        <h3 class="text-2xl">No featured offer is published today</h3>
        <p class="mt-3 text-primary-700">That does not mean there is no value available. Package pricing varies by date, hotel, room occupancy and transport, so a tailored comparison is usually more useful.</p>
        <a href="/planner" class="btn-primary mt-6">Start planning</a>
      </div>
    <% } %>
    <% deals.forEach(function(deal) { %>
      <article class="card">
        <h2 class="text-2xl"><%= deal.title %></h2>
        <p class="mt-3 text-primary-700"><%= deal.description %></p>
        <% if (deal.price) { %>
          <p class="mt-4 font-semibold text-secondary-700">From £<%= deal.price %></p>
        <% } %>
      </article>
    <% }) %>
  </div>
</section>

<section class="bg-blush/60">
  <div class="section">
    <div class="mb-10 max-w-2xl">
      <p class="badge bg-white text-secondary-800">What Deanna checks</p>
      <h2 class="mt-4">Compare like with like</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      <% [
        ['Package inclusions', 'Ticket length, meal plan, transfers, baggage and room type can change the real value.'],
        ['Date flexibility', 'Moving by a day or choosing a different travel time can sometimes unlock stronger options.'],
        ['Family fit', 'A lower price is not better value if the room setup, location or journey makes the trip harder.']
      ].forEach(function(item) { %>
        <article class="card"><h3 class="text-2xl"><%= item[0] %></h3><p class="mt-3 text-primary-700"><%= item[1] %></p></article>
      <% }) %>
    </div>
  </div>
</section>
<%- include('../partials/shell-end') %>
