<%- include('../partials/shell-start') %>
<section class="section">
  <h1 class="text-4xl">Offers & deals</h1>
  <p class="mt-3 max-w-2xl text-primary-700">Seasonal packages and curated value — always checked by Deanna before they’re shared.</p>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <% if (!deals.length) { %>
      <div class="card md:col-span-2">
        <p class="text-primary-700">No public offers right now. Start a plan and Deanna will look for the best fit for your dates.</p>
        <a href="/planner" class="btn-primary mt-6">Start planning</a>
      </div>
    <% } %>
    <% deals.forEach(function(deal) { %>
      <article class="card">
        <h2 class="text-2xl"><%= deal.title %></h2>
        <p class="mt-3 text-primary-700"><%= deal.description %></p>
        <% if (deal.price) { %>
          <p class="mt-4 font-semibold text-secondary-700">From £<%= deal.price %></p>
        <% } %>
      </article>
    <% }) %>
  </div>
</section>
<%- include('../partials/shell-end') %>
