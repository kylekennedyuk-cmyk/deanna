<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<section class="section-sm">
  <%- include('../partials/portal-nav', { backHref: '/agent', backLabel: 'Agent home' }) %>
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="badge bg-white text-secondary-800 shadow-soft">Mailbox</p>
      <h1 class="mt-3 text-display-md">Email</h1>
      <p class="mt-2 text-primary-700">Inbox for dee@destinationswithdeanna.com — read, reply, and send.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/agent/mailbox" class="btn-secondary">Refresh</a>
      <a href="/agent/mailbox/compose" class="btn-primary">Compose</a>
    </div>
  </div>

  <% if (sent) { %><div class="mb-5 rounded-card border border-success-100 bg-success-50 px-4 py-3 text-success-700">Email sent.</div><% } %>
  <% if (error) { %><div class="mb-5 rounded-card border border-danger-100 bg-danger-50 px-4 py-3 text-danger-700" role="alert"><%= error %></div><% } %>

  <div class="space-y-3">
    <% if (!messages.length && !error) { %>
      <div class="card text-primary-600">The inbox is empty.</div>
    <% } %>
    <% messages.forEach(function(msg) { %>
      <a href="/agent/mailbox/<%= msg.uid %>" class="card-hover card-accent block <%= msg.unseen ? 'border-secondary-200 bg-secondary-50/40' : '' %>">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="text-sm font-semibold text-primary-950">
            <% if (msg.unseen) { %><span class="mr-2 inline-block h-2 w-2 rounded-full bg-secondary-600" aria-hidden="true"></span><% } %>
            <%= msg.from %>
          </div>
          <div class="text-xs text-primary-500"><%= msg.date ? formatDateTime(msg.date) : '' %></div>
        </div>
        <div class="mt-1 font-medium text-primary-900"><%= msg.subject %></div>
      </a>
    <% }) %>
  </div>
  <% if (total) { %>
    <p class="mt-6 text-sm text-primary-500">Showing <%= messages.length %> of <%= total %> messages in INBOX.</p>
  <% } %>
</section>
<%- include('../partials/shell-end') %>
