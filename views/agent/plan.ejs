<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<%
  const title = planTitle(plan, preferences || {});
  const tabs = [
    { id: 'overview', label: 'Overview' },
    { id: 'flights', label: 'Flights' },
    { id: 'hotel', label: 'Hotel' },
    { id: 'itinerary', label: 'Itinerary' },
    { id: 'pricing', label: 'Pricing' },
    { id: 'messages', label: 'Messages' },
    { id: 'notes', label: 'Notes' },
  ];
%>
<section class="section-sm">
  <%- include('../partials/portal-nav', { backHref: '/agent/plans?filter=active', backLabel: 'Plans' }) %>
  <% if (saved) { %><div class="mb-4 rounded-card border border-success-100 bg-success-50 px-4 py-3 text-success-700">Saved.</div><% } %>
  <% if (typeof deleted !== 'undefined' && deleted) { %><div class="mb-4 rounded-card border border-success-100 bg-success-50 px-4 py-3 text-success-700">Message deleted.</div><% } %>
  <% if (typeof emailed !== 'undefined' && emailed) { %><div class="mb-4 rounded-card border border-success-100 bg-success-50 px-4 py-3 text-success-700">Message saved. Email notification is sending to <%= plan.customer.email %>.</div><% } %>
  <% if (typeof emailWarn !== 'undefined' && emailWarn) { %><div class="mb-4 rounded-card border border-danger-100 bg-danger-50 px-4 py-3 text-danger-700" role="alert"><%= emailDetail || 'Message saved in the portal, but the customer email notification was not sent.' %></div><% } %>

  <% if (plan.status === 'awaiting_agent' || plan.status === 'new') { %>
    <div class="mb-4 rounded-card border border-danger-100 bg-danger-50 px-4 py-3 text-danger-700" role="status">
      Action required — <%= plan.status === 'new' ? 'new planning request waiting for you.' : 'client message waiting for your reply.' %>
    </div>
  <% } %>

  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="badge bg-white text-secondary-800 shadow-soft">Plan workspace</p>
      <h1 class="mt-3 text-display-md"><%= title %></h1>
      <p class="mt-2 text-primary-600"><%= plan.customer.name %> · <%= plan.customer.email %><% if (plan.customer.phone) { %> · <%= plan.customer.phone %><% } %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/agent" class="btn-ghost">Dashboard</a>
      <a href="/agent/plans" class="btn-ghost">Back to list</a>
    </div>
  </div>

  <div class="mb-6 flex gap-2 overflow-x-auto pb-1" role="tablist" aria-label="Plan sections">
    <% tabs.forEach(function(t) { %>
      <a href="?tab=<%= t.id %>" role="tab" aria-selected="<%= tab === t.id ? 'true' : 'false' %>" class="inline-flex items-center gap-2 whitespace-nowrap rounded-full px-4 py-2 text-sm font-semibold transition <%= tab === t.id ? 'bg-primary-900 text-white' : 'bg-white text-primary-700 shadow-soft hover:bg-secondary-50' %>">
        <%= t.label %>
        <% if (t.id === 'messages') { %>
          <%- include('../partials/count-badge', { count: typeof planUnreadMessages !== 'undefined' ? planUnreadMessages : 0, label: (typeof planUnreadMessages !== 'undefined' ? planUnreadMessages : 0) + ' unread messages on this plan', compact: true }) %>
        <% } %>
      </a>
    <% }) %>
  </div>

  <div class="grid gap-8 lg:grid-cols-[1.35fr_0.85fr]">
    <div class="min-w-0 space-y-4">
      <% if (tab === 'messages') { %>
        <div class="card space-y-4">
          <h2 class="text-2xl">Conversation</h2>
          <% if (!plan.messages.length) { %>
            <p class="text-primary-600">No messages yet. A warm first note goes a long way.</p>
          <% } %>
          <% plan.messages.forEach(function(msg) { %>
            <div class="rounded-2xl bg-primary-50 px-4 py-3">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div class="text-xs font-semibold uppercase tracking-wider text-primary-500"><%= msg.sender.name %> · <%= formatDateTime(msg.createdAt) %></div>
                <form method="post" action="/agent/plans/<%= plan.id %>/messages/<%= msg.id %>/delete" onsubmit="return confirm('Delete this message?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="text-xs font-semibold text-danger-700 hover:underline">Delete</button>
                </form>
              </div>
              <p class="mt-1 whitespace-pre-wrap"><%= msg.content %></p>
            </div>
          <% }) %>
          <div class="flex flex-wrap gap-2 border-t border-primary-100 pt-4">
            <button type="button" class="chip" data-quick-reply="Thank you for your details — I’m reviewing hotels and tickets for your dates now." data-target="#agent-message">Reviewing now</button>
            <button type="button" class="chip" data-quick-reply="I’ve shared a first proposal in your portal. Take a look and tell me what you’d like to tweak." data-target="#agent-message">Proposal ready</button>
            <button type="button" class="chip" data-quick-reply="Happy to adjust the hotel or park days — what matters most for your party?" data-target="#agent-message">Offer tweak</button>
          </div>
          <form method="post" action="/agent/plans/<%= plan.id %>/messages" class="space-y-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label class="label" for="agent-message">Reply</label>
            <textarea class="field min-h-[120px]" id="agent-message" name="content" required></textarea>
            <button class="btn-primary" type="submit">Send reply</button>
            <p class="text-xs text-primary-500">Saves in the portal and emails <%= plan.customer.email %>.</p>
          </form>
        </div>
      <% } else if (tab === 'overview') { %>
        <div class="card">
          <h2 class="text-2xl">Client preferences</h2>
          <p class="mt-1 text-sm text-primary-600">Readable summary — no raw data dumps.</p>
          <div class="mt-5">
            <%- include('../partials/preferences-list', { prefs: preferences }) %>
          </div>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="card">
            <h3 class="text-xl">Flights snapshot</h3>
            <p class="mt-3 whitespace-pre-wrap text-sm text-primary-800"><%= plan.flights || 'Not added yet.' %></p>
            <a href="?tab=flights" class="btn-ghost btn-sm mt-4 px-0">Edit flights</a>
          </div>
          <div class="card">
            <h3 class="text-xl">Hotel snapshot</h3>
            <p class="mt-3 whitespace-pre-wrap text-sm text-primary-800"><%= plan.hotel || 'Not added yet.' %></p>
            <a href="?tab=hotel" class="btn-ghost btn-sm mt-4 px-0">Edit hotel</a>
          </div>
        </div>
      <% } else { %>
        <form method="post" action="/agent/plans/<%= plan.id %>/update" class="card space-y-5">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="tab" value="<%= tab %>" />
          <% if (tab === 'flights') { %>
            <div>
              <h2 class="text-2xl">Flights</h2>
              <p class="mt-1 text-sm text-primary-600">Write this in plain language for the client portal.</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="label" for="flightAirline">Airline</label>
                <input class="field" id="flightAirline" name="flightAirline" value="<%= (flightFields && flightFields.airline) || '' %>" placeholder="e.g. easyJet" />
              </div>
              <div>
                <label class="label" for="flightAirport">UK airport</label>
                <input class="field" id="flightAirport" name="flightAirport" value="<%= (flightFields && flightFields.airport) || '' %>" placeholder="e.g. Manchester" />
              </div>
              <div>
                <label class="label" for="flightOutbound">Outbound</label>
                <input class="field" id="flightOutbound" name="flightOutbound" value="<%= (flightFields && flightFields.outbound) || '' %>" />
              </div>
              <div>
                <label class="label" for="flightReturn">Return</label>
                <input class="field" id="flightReturn" name="flightReturn" value="<%= (flightFields && flightFields.return) || '' %>" />
              </div>
            </div>
            <div>
              <label class="label" for="flightNotes">Notes for client</label>
              <textarea class="field min-h-[120px]" id="flightNotes" name="flightNotes"><%= (flightFields && flightFields.notes) || '' %></textarea>
            </div>
          <% } else if (tab === 'hotel') { %>
            <div>
              <h2 class="text-2xl">Hotel</h2>
              <p class="mt-1 text-sm text-primary-600">Keep it warm and specific — room type, board, and why it suits them.</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="label" for="hotelName">Hotel name</label>
                <input class="field" id="hotelName" name="hotelName" value="<%= (hotelFields && hotelFields.name) || '' %>" />
              </div>
              <div>
                <label class="label" for="hotelRoom">Room type</label>
                <input class="field" id="hotelRoom" name="hotelRoom" value="<%= (hotelFields && hotelFields.room) || '' %>" />
              </div>
              <div>
                <label class="label" for="hotelBoard">Board</label>
                <input class="field" id="hotelBoard" name="hotelBoard" value="<%= (hotelFields && hotelFields.board) || '' %>" />
              </div>
              <div>
                <label class="label" for="hotelNights">Nights</label>
                <input class="field" id="hotelNights" name="hotelNights" value="<%= (hotelFields && hotelFields.nights) || '' %>" />
              </div>
            </div>
            <div>
              <label class="label" for="hotelNotes">Why this hotel</label>
              <textarea class="field min-h-[120px]" id="hotelNotes" name="hotelNotes"><%= (hotelFields && hotelFields.notes) || '' %></textarea>
            </div>
          <% } else if (tab === 'itinerary') { %>
            <div>
              <h2 class="text-2xl">Itinerary</h2>
              <p class="mt-1 text-sm text-primary-600">Day-by-day pacing in friendly language.</p>
            </div>
            <textarea class="field min-h-[280px]" id="itinerary" name="itinerary" placeholder="Day 1 — Arrive and settle…"><%= plan.itinerary || '' %></textarea>
          <% } else if (tab === 'pricing') { %>
            <div>
              <h2 class="text-2xl">Pricing</h2>
              <p class="mt-1 text-sm text-primary-600">Show totals clearly — clients see this wording.</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="label" for="priceTotal">Total (£)</label>
                <input class="field" id="priceTotal" name="priceTotal" type="number" value="<%= (priceFields && priceFields.total) || '' %>" />
              </div>
              <div>
                <label class="label" for="priceDeposit">Deposit (£)</label>
                <input class="field" id="priceDeposit" name="priceDeposit" type="number" value="<%= (priceFields && priceFields.deposit) || '' %>" />
              </div>
            </div>
            <div>
              <label class="label" for="priceIncludes">What’s included</label>
              <textarea class="field min-h-[140px]" id="priceIncludes" name="priceIncludes"><%= (priceFields && priceFields.includes) || '' %></textarea>
            </div>
            <div>
              <label class="label" for="priceMargin">Internal margin notes</label>
              <textarea class="field min-h-[90px]" id="priceMargin" name="priceMargin" placeholder="Not shown to client"><%= (priceFields && priceFields.margin) || '' %></textarea>
              <p class="help">Margin notes stay in your workspace summary only.</p>
            </div>
          <% } else if (tab === 'notes') { %>
            <div>
              <h2 class="text-2xl">Internal notes</h2>
              <p class="mt-1 text-sm text-primary-600">Private to the agent workspace.</p>
            </div>
            <textarea class="field min-h-[240px]" id="notes" name="notes"><%= plan.notes || '' %></textarea>
          <% } %>
          <button class="btn-primary" type="submit">Save <%= tab %></button>
        </form>
      <% } %>
    </div>

    <aside class="sticky-panel h-fit">
      <div class="card space-y-5 bg-gradient-to-br from-white to-blush/40">
        <div>
          <p class="badge bg-white text-secondary-800">Action panel</p>
          <h2 class="mt-3 text-2xl">Plan summary</h2>
        </div>
        <div>
          <div class="kv-row"><span class="kv-label">Client</span><span class="kv-value"><%= plan.customer.name %></span></div>
          <div class="kv-row"><span class="kv-label">Dates</span><span class="kv-value"><%= plan.travelDates %></span></div>
          <div class="kv-row"><span class="kv-label">Party</span><span class="kv-value"><%= plan.partySize %></span></div>
          <div class="kv-row"><span class="kv-label">Budget</span><span class="kv-value"><%= formatMoney(plan.budget) %></span></div>
          <div class="kv-row"><span class="kv-label">Updated</span><span class="kv-value"><%= formatDateTime(plan.updatedAt) %></span></div>
          <% if (priceFields && priceFields.total) { %>
            <div class="kv-row"><span class="kv-label">Quoted total</span><span class="kv-value"><%= formatMoney(priceFields.total) %></span></div>
          <% } %>
          <% if (priceFields && priceFields.margin) { %>
            <div class="rounded-2xl bg-primary-50 px-3 py-2 text-xs text-primary-700"><strong>Margin:</strong> <%= priceFields.margin %></div>
          <% } %>
        </div>

        <form method="post" action="/agent/plans/<%= plan.id %>/update" class="space-y-3 border-t border-primary-100 pt-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="tab" value="<%= tab %>" />
          <label class="label" for="status">Plan status</label>
          <select class="field" id="status" name="status">
            <% (typeof PLAN_STATUS_OPTIONS !== 'undefined' ? PLAN_STATUS_OPTIONS : ['new','in_progress','awaiting_agent','awaiting_client','sent','completed','archived']).forEach(function(s) { %>
              <option value="<%= s %>" <%= plan.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
            <% }) %>
          </select>
          <button class="btn-secondary w-full" type="submit">Update status</button>
        </form>

        <form method="post" action="/agent/plans/<%= plan.id %>/send" onsubmit="return confirm('Mark this plan as sent to the client?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn-primary w-full" type="submit">Send to client</button>
        </form>

        <a href="/agent/plans/<%= plan.id %>?tab=messages" class="btn-ghost w-full">Quick message</a>

        <form method="post" action="/agent/plans/<%= plan.id %>/delete" class="border-t border-primary-100 pt-4" onsubmit="return confirm('Permanently delete this holiday plan and all of its messages? This cannot be undone.');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn-destructive w-full" type="submit">Delete plan</button>
        </form>
      </div>
    </aside>
  </div>
</section>
<%- include('../partials/shell-end') %>
