<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<section class="section-sm max-w-4xl">
  <%- include('../partials/portal-nav', { backHref: '/agent/mailbox?folder=' + encodeURIComponent(activeFolder || 'INBOX'), backLabel: 'Mailbox' }) %>

  <% if (error && !message) { %>
    <div class="mb-5 rounded-card border border-danger-100 bg-danger-50 px-4 py-3 text-danger-700" role="alert"><%= error %></div>
    <a href="/agent/mailbox?folder=<%= encodeURIComponent(activeFolder || 'INBOX') %>" class="btn-secondary">Back to mailbox</a>
  <% } else if (message) { %>
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="badge bg-white text-secondary-800 shadow-soft"><%= message.folderLabel || 'Message' %></p>
        <h1 class="mt-3 text-display-md"><%= message.subject %></h1>
        <p class="mt-2 text-primary-700">From <%= message.from %><% if (message.date) { %> · <%= formatDateTime(message.date) %><% } %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/agent/mailbox?folder=<%= encodeURIComponent(activeFolder || message.folder || 'INBOX') %>" class="btn-secondary">Back</a>
        <% if (message.folderKey !== 'sent') { %>
          <a href="/agent/mailbox/m/<%= message.uid %>/reply?folder=<%= encodeURIComponent(activeFolder || message.folder || 'INBOX') %>" class="btn-primary">Reply</a>
        <% } %>
      </div>
    </div>

    <article class="card space-y-4">
      <dl class="grid gap-3 text-sm sm:grid-cols-[7rem_1fr]">
        <dt class="font-semibold text-primary-500">From</dt>
        <dd class="text-primary-900"><%= message.from %></dd>
        <dt class="font-semibold text-primary-500">To</dt>
        <dd class="text-primary-900"><%= message.to || '—' %></dd>
        <% if (message.cc) { %>
          <dt class="font-semibold text-primary-500">Cc</dt>
          <dd class="text-primary-900"><%= message.cc %></dd>
        <% } %>
        <dt class="font-semibold text-primary-500">Subject</dt>
        <dd class="text-primary-900"><%= message.subject %></dd>
      </dl>

      <div class="border-t border-primary-100 pt-5">
        <pre class="whitespace-pre-wrap font-sans text-base leading-relaxed text-primary-900"><%= message.text || '(No text content)' %></pre>
      </div>

      <% if (message.attachments && message.attachments.length) { %>
        <div class="border-t border-primary-100 pt-5">
          <h2 class="text-lg font-semibold text-primary-950">Attachments</h2>
          <ul class="mt-2 space-y-1 text-sm text-primary-700">
            <% message.attachments.forEach(function(file) { %>
              <li><%= file.filename %><% if (file.size) { %> · <%= Math.round(file.size / 1024) %> KB<% } %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <div class="flex flex-wrap items-center gap-3 border-t border-primary-100 pt-5">
        <form method="post" action="/agent/mailbox/m/<%= message.uid %>/delete" onsubmit="return confirm('<%= message.folderKey === 'trash' ? 'Permanently delete this message?' : 'Move this message to Deleted?' %>');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="folder" value="<%= activeFolder || message.folder || 'INBOX' %>" />
          <button type="submit" class="btn-logout btn-sm"><%= message.folderKey === 'trash' ? 'Delete forever' : 'Delete' %></button>
        </form>

        <% if (message.folderKey === 'trash') { %>
          <form method="post" action="/agent/mailbox/m/<%= message.uid %>/move">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="folder" value="<%= activeFolder || message.folder || 'INBOX' %>" />
            <input type="hidden" name="destination" value="inbox" />
            <button type="submit" class="btn-secondary btn-sm">Restore to Inbox</button>
          </form>
        <% } else if (message.folderKey !== 'junk') { %>
          <form method="post" action="/agent/mailbox/m/<%= message.uid %>/move" class="flex flex-wrap items-center gap-2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="folder" value="<%= activeFolder || message.folder || 'INBOX' %>" />
            <label class="sr-only" for="destination">Move to</label>
            <select class="field py-2" id="destination" name="destination">
              <option value="inbox">Inbox</option>
              <option value="sent">Sent</option>
              <option value="drafts">Drafts</option>
              <option value="archive">Archive</option>
              <option value="junk">Junk</option>
              <option value="trash">Deleted</option>
            </select>
            <button type="submit" class="btn-secondary btn-sm">Move</button>
          </form>
        <% } %>
      </div>
    </article>
  <% } %>
</section>
<%- include('../partials/shell-end') %>
