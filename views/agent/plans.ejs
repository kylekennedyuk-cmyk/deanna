<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<section class="section-sm">
  <%- include('../partials/portal-nav', { backHref: '/agent', backLabel: 'Agent home' }) %>
  <div class="mb-8">
    <p class="badge bg-white text-secondary-800 shadow-soft">All plans</p>
    <h1 class="mt-3 text-display-md">Holiday plans</h1>
  </div>
  <div class="space-y-3">
    <% plans.forEach(function(plan) { %>
      <%
        let prefs = {};
        try { prefs = JSON.parse(plan.preferences || '{}'); } catch (e) { prefs = {}; }
      %>
      <a href="/agent/plans/<%= plan.id %>" class="card-hover card-accent flex flex-wrap items-center justify-between gap-3">
        <div>
          <div class="font-semibold text-primary-950"><%= planTitle(plan, prefs) %> · <%= plan.customer.name %></div>
          <div class="text-sm text-primary-600"><%= plan.travelDates %> · <%= plan.customer.email %> · <%= formatMoney(plan.budget) %></div>
        </div>
        <%- include('../partials/status-badge', { status: plan.status }) %>
      </a>
    <% }) %>
  </div>
</section>
<%- include('../partials/shell-end') %>
