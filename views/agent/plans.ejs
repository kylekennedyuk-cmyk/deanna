<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<%
  const currentFilter = typeof filter !== 'undefined' ? filter : 'active';
  const tabs = [
    { id: 'active', label: 'Active', href: '/agent/plans?filter=active' },
    { id: 'action', label: 'Action required', href: '/agent/plans?filter=action' },
    { id: 'awaiting_client', label: 'Awaiting client', href: '/agent/plans?filter=awaiting_client' },
    { id: 'bookings', label: 'Bookings', href: '/agent/plans?filter=bookings' },
    { id: 'all', label: 'All', href: '/agent/plans?filter=all' },
  ];
%>
<section class="section-sm">
  <%- include('../partials/portal-nav', { backHref: '/agent', backLabel: 'Agent home' }) %>
  <div class="mb-6">
    <p class="badge bg-white text-secondary-800 shadow-soft">Plans</p>
    <h1 class="mt-3 inline-flex flex-wrap items-center gap-3 text-display-md">
      <%= title %>
      <%- include('../partials/count-badge', { count: badgeCounts.plans, label: badgeCounts.plans + ' plans needing action' }) %>
    </h1>
    <p class="mt-2 text-primary-700">Active holiday plans with status, last activity, and action cues.</p>
  </div>

  <% if (typeof deleted !== 'undefined' && deleted) { %>
    <div class="mb-4 rounded-card border border-success-100 bg-success-50 px-4 py-3 text-success-700">Plan deleted.</div>
  <% } %>

  <div class="mb-6 flex gap-2 overflow-x-auto pb-1" role="tablist" aria-label="Plan filters">
    <% tabs.forEach(function(t) { %>
      <a href="<%= t.href %>" role="tab" aria-selected="<%= currentFilter === t.id ? 'true' : 'false' %>" class="inline-flex items-center gap-2 whitespace-nowrap rounded-full px-4 py-2 text-sm font-semibold transition <%= currentFilter === t.id ? 'bg-primary-900 text-white' : 'bg-white text-primary-700 shadow-soft hover:bg-secondary-50' %>">
        <%= t.label %>
        <% if (t.id === 'action') { %>
          <%- include('../partials/count-badge', { count: badgeCounts.plans, label: badgeCounts.plans + ' plans needing action', compact: true }) %>
        <% } %>
      </a>
    <% }) %>
  </div>

  <div class="space-y-3">
    <% if (!plans.length) { %>
      <div class="card text-primary-600">No plans in this view.</div>
    <% } %>
    <% plans.forEach(function(plan) { %>
      <%
        let prefs = {};
        try { prefs = JSON.parse(plan.preferences || '{}'); } catch (e) { prefs = {}; }
        const unread = unreadByPlan && unreadByPlan[plan.id] ? unreadByPlan[plan.id] : 0;
        const lastMsg = plan.messages && plan.messages[0] ? plan.messages[0] : null;
        const needsAction = plan.status === 'awaiting_agent' || plan.status === 'new';
      %>
      <a href="/agent/plans/<%= plan.id %>" class="card-hover card-accent flex flex-wrap items-center justify-between gap-3 <%= needsAction ? 'ring-1 ring-danger-100' : '' %>">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <div class="font-semibold text-primary-950"><%= planTitle(plan, prefs) %> · <%= plan.customer.name %></div>
            <% if (needsAction) { %><span class="badge bg-danger-100 text-danger-700">Action needed</span><% } %>
            <%- include('../partials/count-badge', { count: unread, label: unread + ' unread messages', compact: true }) %>
          </div>
          <div class="mt-1 text-sm text-primary-600"><%= plan.travelDates %> · <%= plan.customer.email %> · <%= formatMoney(plan.budget) %></div>
          <div class="mt-1 text-xs text-primary-500">
            Updated <%= formatDateTime(plan.updatedAt) %>
            <% if (lastMsg) { %> · Last message <%= formatDateTime(lastMsg.createdAt) %><% } %>
            <% if (plan.bookingReference) { %> · Ref <%= plan.bookingReference %><% } %>
          </div>
        </div>
        <%- include('../partials/status-badge', { status: plan.status }) %>
      </a>
    <% }) %>
  </div>
</section>
<%- include('../partials/shell-end') %>
