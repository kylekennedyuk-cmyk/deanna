<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<section class="section-sm max-w-lg">
  <%- include('../partials/portal-nav', { backHref: '/agent', backLabel: 'Agent home' }) %>
  <p class="badge bg-secondary-100 text-secondary-800">Account</p>
  <h1 class="mt-3 text-display-md">Change password</h1>
  <p class="mt-2 text-primary-700">Choose a new password for your agent workspace login.</p>
  <% if (saved) { %><div class="mt-4 rounded-card border border-success-100 bg-success-50 px-4 py-3 text-success-700">Password updated.</div><% } %>
  <% if (error) { %><div class="mt-4 rounded-card border border-danger-100 bg-danger-50 px-4 py-3 text-danger-700"><%= error %></div><% } %>

  <form method="post" action="/agent/password" class="card mt-6 space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div>
      <label class="label" for="currentPassword">Current password</label>
      <input class="field" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required />
    </div>
    <div>
      <label class="label" for="newPassword">New password</label>
      <input class="field" id="newPassword" name="newPassword" type="password" minlength="8" autocomplete="new-password" required />
      <p class="help">At least 8 characters.</p>
    </div>
    <div>
      <label class="label" for="confirmPassword">Confirm new password</label>
      <input class="field" id="confirmPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required />
    </div>
    <button class="btn-primary" type="submit">Update password</button>
  </form>
</section>
<%- include('../partials/shell-end') %>
