<%- include('../partials/shell-start', { bodyClass: 'portal-shell' }) %>
<%
  const progress = Math.round((step / steps.length) * 100);
  const interestOptions = ['Rides', 'Shows', 'Characters', 'Food', 'Shopping', 'Parades', 'Relaxing'];
  const selectedInterests = String(data.interests || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean);
  const paceOptions = [
    { value: 'relaxed', label: 'Relaxed', help: 'Slower mornings, fewer must-dos' },
    { value: 'balanced', label: 'Balanced', help: 'A mix of magic and downtime' },
    { value: 'packed', label: 'Packed', help: 'Maximise park time' },
  ];
  const currentPace = data.pace || 'balanced';
%>
<section class="section-sm pb-28 lg:pb-16">
  <div class="mb-8 max-w-3xl">
    <p class="badge bg-secondary-100 text-secondary-800">Holiday planner</p>
    <h1 class="mt-4 text-display-md sm:text-display-lg">Plan your Disneyland Paris adventure</h1>
    <p class="mt-3 max-w-2xl text-lg text-primary-700">A guided journey — a few thoughtful questions, then Deanna takes it from there.</p>
  </div>

  <div class="mb-8 rounded-card border border-primary-100/80 bg-white/90 p-4 shadow-soft sm:p-5">
    <div class="mb-3 flex items-center justify-between gap-3">
      <p class="text-sm font-semibold text-primary-900">Step <%= step %> of <%= steps.length %> · <%= steps[step - 1].title %></p>
      <p class="text-sm text-primary-500"><%= progress %>%</p>
    </div>
    <div class="stepper-track" aria-hidden="true"><div class="stepper-fill" style="width:<%= progress %>%"></div></div>
    <div class="mt-4 -mx-1 flex gap-2 overflow-x-auto pb-1" role="list" aria-label="Planner steps">
      <% steps.forEach(function(s) { %>
        <span role="listitem" class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold <%= s.id === step ? 'bg-primary-900 text-white' : (s.id < step ? 'bg-secondary-100 text-secondary-800' : 'bg-primary-50 text-primary-500') %>">
          <%= s.id %>. <%= s.title %>
        </span>
      <% }) %>
    </div>
  </div>

  <% if (error) { %>
    <div class="mb-6 rounded-card border border-danger-100 bg-danger-50 px-4 py-3 text-danger-700" role="alert"><%= error %></div>
  <% } %>

  <form method="post" action="<%= step === 8 ? '/planner/submit' : '/planner/step/' + step %>" class="grid gap-8 lg:grid-cols-[1.35fr_0.85fr]" data-autosave-toast>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="card space-y-6">
      <% if (step === 1) { %>
        <div>
          <h2 class="text-display-sm">Trip basics</h2>
          <p class="mt-2 text-primary-700">We’ll shape hotel nights and park days around this window.</p>
        </div>
        <div>
          <label class="label" for="dates">Travel dates or window</label>
          <input class="field" id="dates" name="dates" value="<%= data.dates || '' %>" placeholder="e.g. Easter half-term 2027, flexible by a week" required />
          <p class="help">Flexible dates help Deanna find better hotel and ticket value.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="nights">Nights</label>
            <input class="field" id="nights" name="nights" type="number" min="1" value="<%= data.nights || 4 %>" />
          </div>
          <div>
            <label class="label" for="airport">Preferred airport</label>
            <input class="field" id="airport" name="airport" value="<%= data.airport || '' %>" placeholder="Nearest / Manchester / Gatwick…" />
          </div>
        </div>
      <% } else if (step === 2) { %>
        <div>
          <h2 class="text-display-sm">Travellers</h2>
          <p class="mt-2 text-primary-700">Ages help with tickets, room setup, and ride suitability.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="adults">Adults</label>
            <input class="field" id="adults" name="adults" type="number" min="1" value="<%= data.adults || 2 %>" />
          </div>
          <div>
            <label class="label" for="children">Children</label>
            <input class="field" id="children" name="children" type="number" min="0" value="<%= data.children || 0 %>" />
          </div>
        </div>
        <div>
          <label class="label" for="childAges">Children’s ages</label>
          <input class="field" id="childAges" name="childAges" value="<%= data.childAges || '' %>" placeholder="e.g. 5, 8" />
          <p class="help">Optional if you don’t have exact ages yet.</p>
        </div>
        <div>
          <label class="label" for="occasion">Occasion</label>
          <select class="field" id="occasion" name="occasion">
            <% ['First visit','Birthday','Anniversary','Honeymoon','Family holiday','Other'].forEach(function(o) { %>
              <option value="<%= o %>" <%= data.occasion === o ? 'selected' : '' %>><%= o %></option>
            <% }) %>
          </select>
        </div>
      <% } else if (step === 3) { %>
        <div>
          <h2 class="text-display-sm">Style & preferences</h2>
          <p class="mt-2 text-primary-700">There’s no wrong answer — this helps pace the days kindly.</p>
        </div>
        <div data-chip-group>
          <p class="label">Pace</p>
          <input type="hidden" name="pace" data-chip-value value="<%= currentPace %>" />
          <div class="mt-2 flex flex-wrap gap-2">
            <% paceOptions.forEach(function(opt) { %>
              <label class="chip <%= currentPace === opt.value ? 'chip-active' : '' %>">
                <input class="chip-input" type="radio" name="paceChip" value="<%= opt.value %>" <%= currentPace === opt.value ? 'checked' : '' %> />
                <span>
                  <span class="block"><%= opt.label %></span>
                  <span class="block text-xs opacity-80"><%= opt.help %></span>
                </span>
              </label>
            <% }) %>
          </div>
        </div>
        <div data-chip-group data-multi="true">
          <p class="label">Interests</p>
          <input type="hidden" name="interests" data-chip-value value="<%= data.interests || '' %>" />
          <div class="mt-2 flex flex-wrap gap-2">
            <% interestOptions.forEach(function(opt) { %>
              <label class="chip <%= selectedInterests.indexOf(opt) !== -1 ? 'chip-active' : '' %>">
                <input class="chip-input" type="checkbox" value="<%= opt %>" <%= selectedInterests.indexOf(opt) !== -1 ? 'checked' : '' %> />
                <%= opt %>
              </label>
            <% }) %>
          </div>
          <p class="help">Pick as many as you like — Deanna will prioritise gently.</p>
        </div>
        <div>
          <label class="label" for="mustHaves">Must-haves</label>
          <input class="field" id="mustHaves" name="mustHaves" value="<%= data.mustHaves || '' %>" placeholder="Park Hopper, half-board, transfers…" />
        </div>
        <div>
          <label class="label" for="avoid">Prefer to avoid</label>
          <input class="field" id="avoid" name="avoid" value="<%= data.avoid || '' %>" placeholder="Long queues, early starts, certain rides…" />
        </div>
      <% } else if (step === 4) { %>
        <div>
          <h2 class="text-display-sm">Disneyland focus</h2>
          <p class="mt-2 text-primary-700">Tell us where the magic matters most for your party.</p>
        </div>
        <div>
          <label class="label" for="parks">Park priority</label>
          <input class="field" id="parks" name="parks" value="<%= data.parks || '' %>" placeholder="Disneyland Park, Adventure World…" />
        </div>
        <div>
          <label class="label" for="lands">Lands & experiences</label>
          <textarea class="field min-h-[100px]" id="lands" name="lands" placeholder="Frozen, Marvel, Pixar, character meets…"><%= data.lands || '' %></textarea>
        </div>
        <div>
          <label class="label" for="diningStyle">Dining style</label>
          <input class="field" id="diningStyle" name="diningStyle" value="<%= data.diningStyle || '' %>" placeholder="Quick service, table service, character dining…" />
        </div>
      <% } else if (step === 5) { %>
        <div>
          <h2 class="text-display-sm">Budget</h2>
          <p class="mt-2 text-primary-700">A range is perfect — Deanna will suggest options that fit.</p>
        </div>
        <div>
          <label class="label" for="budget">Total budget (approx, £)</label>
          <input class="field" id="budget" name="budget" type="number" min="0" step="50" value="<%= data.budget || '' %>" />
          <p class="help">Include flights, hotel, tickets, and meals if you can.</p>
        </div>
        <div data-chip-group>
          <p class="label">Flexibility</p>
          <input type="hidden" name="flexibility" data-chip-value value="<%= data.flexibility || 'somewhat' %>" />
          <div class="mt-2 flex flex-wrap gap-2">
            <% [['strict','Strict'],['somewhat','Somewhat flexible'],['flexible','Very flexible']].forEach(function(opt) { %>
              <label class="chip <%= (data.flexibility || 'somewhat') === opt[0] ? 'chip-active' : '' %>">
                <input class="chip-input" type="radio" name="flexChip" value="<%= opt[0] %>" <%= (data.flexibility || 'somewhat') === opt[0] ? 'checked' : '' %> />
                <%= opt[1] %>
              </label>
            <% }) %>
          </div>
        </div>
      <% } else if (step === 6) { %>
        <div>
          <h2 class="text-display-sm">Accommodation</h2>
          <p class="mt-2 text-primary-700">Disney hotels are convenient; partners can stretch the budget.</p>
        </div>
        <div>
          <label class="label" for="hotelType">Hotel type</label>
          <select class="field" id="hotelType" name="hotelType">
            <% ['Disney hotel','Partner hotel','Apartment / other','Open to suggestions'].forEach(function(o) { %>
              <option <%= data.hotelType === o ? 'selected' : '' %>><%= o %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="label" for="board">Board basis</label>
          <select class="field" id="board" name="board">
            <% ['Room only','Breakfast','Half board','Not sure'].forEach(function(o) { %>
              <option <%= data.board === o ? 'selected' : '' %>><%= o %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="label" for="roomPrefs">Room preferences</label>
          <input class="field" id="roomPrefs" name="roomPrefs" value="<%= data.roomPrefs || '' %>" placeholder="View, connecting rooms, quiet floor…" />
        </div>
      <% } else if (step === 7) { %>
        <div>
          <h2 class="text-display-sm">Special requirements</h2>
          <p class="mt-2 text-primary-700">Anything that helps Deanna look after you well — no detail is too small.</p>
        </div>
        <div>
          <label class="label" for="accessibility">Accessibility needs</label>
          <textarea class="field min-h-[90px]" id="accessibility" name="accessibility"><%= data.accessibility || '' %></textarea>
        </div>
        <div>
          <label class="label" for="dietary">Dietary requirements</label>
          <textarea class="field min-h-[90px]" id="dietary" name="dietary"><%= data.dietary || '' %></textarea>
        </div>
        <div>
          <label class="label" for="celebration">Celebrations / notes</label>
          <textarea class="field min-h-[90px]" id="celebration" name="celebration"><%= data.celebration || '' %></textarea>
        </div>
      <% } else { %>
        <div>
          <h2 class="text-display-sm">Review & submit</h2>
          <p class="mt-2 text-primary-700">Add your contact details so Deanna can start your plan.</p>
        </div>
        <div class="rounded-2xl bg-primary-50/70 p-4">
          <%- include('../partials/preferences-list', { prefs: data }) %>
        </div>
        <div>
          <label class="label" for="name">Name</label>
          <input class="field" id="name" name="name" value="<%= data.name || (currentUser && currentUser.name) || '' %>" required />
        </div>
        <div>
          <label class="label" for="email">Email</label>
          <input class="field" id="email" name="email" type="email" value="<%= data.email || (currentUser && currentUser.email) || '' %>" required <%= currentUser ? 'readonly' : '' %> />
          <p class="help"><%= currentUser ? 'We’ll confirm to this email.' : 'After you submit, you’ll set a password. Your email is your login username.' %></p>
        </div>
        <div>
          <label class="label" for="phone">Phone</label>
          <input class="field" id="phone" name="phone" value="<%= data.phone || (currentUser && currentUser.phone) || '' %>" />
        </div>
        <% if (!currentUser) { %>
          <div class="rounded-2xl border border-secondary-200 bg-secondary-50/60 px-4 py-3 text-sm text-primary-800">
            Next step: create your password on the account setup page. Use your email to log in later.
          </div>
        <% } %>
        <label class="flex items-start gap-3 text-sm text-primary-700">
          <input type="checkbox" name="terms" value="yes" required class="mt-1 rounded border-primary-300 text-primary-900 focus:ring-secondary-400" />
          <span>I’m happy for Destinations With Deanna to contact me about this holiday plan.</span>
        </label>
      <% } %>

      <div class="hidden flex-wrap gap-3 pt-2 lg:flex">
        <% if (step > 1 && step < 8) { %>
          <button class="btn-ghost" type="submit" name="action" value="back">Back</button>
        <% } %>
        <% if (step === 8) { %>
          <button class="btn-primary" type="submit">Submit plan</button>
        <% } else { %>
          <button class="btn-primary" type="submit" name="action" value="next">Continue</button>
        <% } %>
      </div>
    </div>

    <aside class="sticky-panel hidden h-fit lg:block">
      <div class="card bg-gradient-to-br from-white to-blush/50">
        <p class="badge bg-white text-secondary-800">Your plan so far</p>
        <h3 class="mt-4 text-2xl">Trip summary</h3>
        <div class="mt-4 space-y-0">
          <div class="kv-row"><span class="kv-label">Dates</span><span class="kv-value"><%= data.dates || '—' %></span></div>
          <div class="kv-row"><span class="kv-label">Party</span><span class="kv-value"><%= (data.adults || '—') %> adults<% if (data.children) { %>, <%= data.children %> children<% } %></span></div>
          <div class="kv-row"><span class="kv-label">Budget</span><span class="kv-value"><%= data.budget ? formatMoney(data.budget) : '—' %></span></div>
          <div class="kv-row"><span class="kv-label">Pace</span><span class="kv-value"><%= data.pace || '—' %></span></div>
          <div class="kv-row"><span class="kv-label">Interests</span><span class="kv-value"><%= data.interests || '—' %></span></div>
        </div>
        <p class="mt-5 text-sm text-primary-600">Progress saves automatically in this session. You can continue later from your email confirmation once submitted.</p>
        <% if (!currentUser) { %>
          <p class="mt-3 text-sm text-primary-600">Already planning with us? <a class="font-semibold text-primary-900 underline" href="/login">Log in</a> to keep everything in one place.</p>
        <% } %>
      </div>
    </aside>

    <div class="mobile-cta-bar flex gap-3 lg:hidden">
      <% if (step > 1 && step < 8) { %>
        <button class="btn-ghost flex-1" type="submit" name="action" value="back">Back</button>
      <% } %>
      <% if (step === 8) { %>
        <button class="btn-primary flex-1" type="submit">Submit plan</button>
      <% } else { %>
        <button class="btn-primary flex-1" type="submit" name="action" value="next">Continue</button>
      <% } %>
    </div>
  </form>
</section>
<%- include('../partials/shell-end') %>
