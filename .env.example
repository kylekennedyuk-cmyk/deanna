# Copy this file to .env and adjust values for your server.

# App
APP_URL=https://destinationswithdeanna.com
PORT=3000
NODE_ENV=production

# Session (generate a long random string for production)
SESSION_SECRET=change-me-to-a-long-random-secret
# Used to encrypt SMTP credentials stored from the admin dashboard.
# Generate another long random value and do not change it after saving SMTP settings.
SETTINGS_ENCRYPTION_KEY=change-me-to-another-long-random-secret

# SQLite — simplest for Plesk. File is created automatically under /data
DATABASE_URL="file:../data/deanna.db"

# Default admin is seeded on first setup:
#   username: admin
#   password: password
# Change the password after first login.

# Optional SMTP (emails skipped until configured)
# These can also be configured in Admin → Email & notifications.
# Prefer env when admin DB SMTP fields are empty (see src/config/email.js).
# From / username must be @destinationswithdeanna.com (SPF/DKIM/DMARC alignment).
SMTP_HOST=prime.ax
SMTP_PORT=465
SMTP_USER=dee@destinationswithdeanna.com
SMTP_PASS=
SMTP_FROM_EMAIL=dee@destinationswithdeanna.com
SMTP_FROM_NAME=Destinations With Deanna
SMTP_FROM="Destinations With Deanna <dee@destinationswithdeanna.com>"
SMTP_SECURE=true

# Optional app-side DKIM (prefer Plesk/Prime server signing instead).
# Never commit the private key. Use escaped newlines (\n) if storing in one line.
# DKIM_DOMAIN=destinationswithdeanna.com
# DKIM_SELECTOR=default
# DKIM_PRIVATE_KEY=

# Optional IMAP for the agent/admin mailbox at /agent/mailbox
# Falls back to SMTP_USER / SMTP_PASS when unset.
IMAP_HOST=prime.ax
IMAP_PORT=993
IMAP_USER=dee@destinationswithdeanna.com
IMAP_PASS=

SUPPORT_EMAIL=dee@destinationswithdeanna.com
