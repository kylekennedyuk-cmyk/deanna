# Copy this file to .env on the server (httpdocs/.env) via Plesk File Manager.
# Plesk "Run script" often does NOT pass Node.js panel environment variables,
# so Prisma/deploy needs this file.

NODE_ENV=production
APP_URL=https://destinationswithdeanna.com
SESSION_SECRET=change-me-to-a-long-random-secret
SETTINGS_ENCRYPTION_KEY=change-me-to-another-long-random-secret
DATABASE_URL=file:../data/deanna.db
SUPPORT_EMAIL=hello@destinationswithdeanna.com

# Do NOT set PORT on Plesk — Passenger chooses the port.
