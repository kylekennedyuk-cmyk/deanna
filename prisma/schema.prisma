generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int           @id @default(autoincrement())
  email                   String        @unique
  username                String?       @unique
  passwordHash            String
  role                    String        @default("customer") // customer | agent | admin
  name                    String
  phone                   String?
  emailNotify             Boolean       @default(true)
  /// Once true, historical plan messages were backfilled as read for this user.
  messageReadsInitialized Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  plans                   HolidayPlan[] @relation("PlanCustomer")
  agentPlans              HolidayPlan[] @relation("PlanAgent")
  messages                Message[]
  messageReads            MessageRead[]
  documents               Document[]
  resetTokens             PasswordResetToken[]
  changeRequests          ChangeRequest[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model HolidayPlan {
  id          Int        @id @default(autoincrement())
  customerId  Int
  customer    User       @relation("PlanCustomer", fields: [customerId], references: [id])
  agentId     Int?
  agent       User?      @relation("PlanAgent", fields: [agentId], references: [id])
  /// new | in_progress | awaiting_agent | awaiting_client | sent | booked | confirmed | completed | archived
  /// booked   = deposit taken / supplier reservation held, paperwork still being finalised.
  /// confirmed = booking confirmed with the supplier; customer-facing confirmation PDF is available.
  status      String     @default("new")
  travelDates String
  partySize   Int
  budget      Int
  preferences String     @default("{}") // JSON
  flights     String? // JSON
  hotel       String? // JSON
  itinerary   String? // JSON
  pricing     String? // JSON
  notes       String?
  /// Supplier / agency booking reference shown to the customer once booked.
  bookingReference String?
  /// Customer-facing confirmation copy (payments taken, tickets, transfer times…).
  confirmationDetails String?
  bookedAt    DateTime?
  confirmedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  messages    Message[]
  documents   Document[]
}

model Message {
  id         Int           @id @default(autoincrement())
  planId     Int
  plan       HolidayPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  senderId   Int
  sender     User          @relation(fields: [senderId], references: [id])
  content    String
  attachment String?
  createdAt  DateTime      @default(now())
  reads      MessageRead[]
}

/// Per-user read receipts for in-app plan messages. Absence of a row means unread
/// (for that user), but only after User.messageReadsInitialized is true — first
/// visit backfills all currently accessible incoming messages as read so legacy
/// history does not inflate badges.
model MessageRead {
  id        Int      @id @default(autoincrement())
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  seoTitle  String?
  seoDesc   String?
  sections  String   @default("[]") // JSON content blocks
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id         Int      @id @default(autoincrement())
  url        String
  alt        String?
  caption    String?
  folder     String?
  uploadedAt DateTime @default(now())
}

model Deal {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  price       Int?
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SiteSetting {
  key   String @id
  value String
}

model Document {
  id         Int          @id @default(autoincrement())
  planId     Int?
  plan       HolidayPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?        @relation(fields: [userId], references: [id])
  url        String
  name       String
  type       String
  uploadedAt DateTime     @default(now())
}

model NavItem {
  id        Int      @id @default(autoincrement())
  label     String
  href      String
  location  String   @default("header") // header | footer
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Agent-submitted website content changes for admin to action.
model ChangeRequest {
  id             Int      @id @default(autoincrement())
  requesterId    Int
  requester      User     @relation(fields: [requesterId], references: [id])
  area           String // homepage | offers | copy | navigation | other
  title          String
  details        String
  /// open | in_progress | actioned | declined
  status         String   @default("open")
  resolutionNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
